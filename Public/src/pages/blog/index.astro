---
import Layout from '../../layouts/Layout.astro';
import { companyBlogPosts } from '../../data/blogPosts';

// 会社・活動ブログ（ルート /blog/）
// 記事データの正本は src/data/blogPosts.ts。
// AI事業の記事一覧は /ai/blog/（src/pages/ai/blog/index.astro）。

const posts = companyBlogPosts;

const title = "ブログ｜株式会社コールテン";
const description = "株式会社コールテンの歩み・地域での活動・お知らせを発信しています。AI活用・導入事例の記事はAI事業の記事一覧をご覧ください。";
---

<Layout
  title={title}
  description={description}
  canonicalUrl="https://www.corduroy.co.jp/blog/"
  ogUrl="https://www.corduroy.co.jp/blog/"
  ogType="website"
>
  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "トップ", "item": "https://www.corduroy.co.jp/"},
        {"@type": "ListItem", "position": 2, "name": "ブログ"}
      ]
    }
  </script>

  <main>
    <section class="hero">
      <div class="container">
        <div class="fade-up" style="text-align:center;">
          <span class="eyebrow">BLOG</span>
          <h1>ブログ</h1>
          <p class="hero-description">コールテンの歩み・活動・お知らせ。</p>
        </div>
      </div>
    </section>

    <section class="container" style="padding-top:20px; padding-bottom:120px;">
      <a href="/ai/blog/" class="featured-banner fade-up">
        <div class="featured-banner-inner">
          <div class="featured-banner-text">
            <span class="featured-eyebrow">AI BUSINESS</span>
            <p class="featured-title">AI活用・導入事例・インタビューの記事は「AIブログ」へ</p>
            <p class="featured-desc">AI顧問の現場から生まれた活用ノウハウ、クライアントさんのインタビュー、AIエージェント組織の運用記録などを発信しています。</p>
            <span class="featured-link">AIブログを見る →</span>
          </div>
        </div>
      </a>

      <div class="posts-list fade-up">
        {posts.length === 0 ? (
          <div class="empty-state">
            <p>まだ投稿はありません。</p>
          </div>
        ) : (
          posts.map((post) => (
            <a
              href={post.external ? post.slug : (post.slug.startsWith('/') ? post.slug : `/blog/${post.slug}/`)}
              class:list={['post-card', { featured: post.featured }]}
              target={post.external ? '_blank' : '_self'}
              rel={post.external ? 'noopener noreferrer' : undefined}
            >
              {post.featured && <span class="recommend-badge">おすすめ</span>}
              <div class="post-thumb">
                <img src={post.thumbnail} alt="" width="120" height="120" loading="lazy" />
              </div>
              <div class="post-body">
                <div class="post-meta">
                  <time class="post-date">{post.date}</time>
                  {Array.isArray(post.category)
                    ? post.category.map(cat => <span class="post-cat">{cat}</span>)
                    : <span class="post-cat">{post.category}</span>
                  }
                </div>
                <h2 class="post-title">{post.title}</h2>
                <p class="post-excerpt">{post.excerpt}</p>
                <span class="post-link">続きを読む →</span>
              </div>
            </a>
          ))
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .hero {
    padding: 60px 0 40px;
    border-bottom: 1px solid #d7e1dc;
    background: var(--cream);
    text-align: center;
  }
  .eyebrow {
    display: inline-block;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.2em;
    font-size: 12px;
    font-family: "Space Grotesk", sans-serif;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-size: clamp(36px, 5vw, 54px);
    margin-bottom: 0;
  }
  .hero-description {
    margin: 14px 0 0;
    color: var(--text-light);
    font-size: 14px;
  }

  .posts-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .post-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 28px 32px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 10px rgba(5,32,24,0.04);
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(5,32,24,0.08);
    border-color: rgba(22,97,78,0.18);
  }
  .post-card.featured {
    background: var(--sea);
    border-color: var(--sea);
    color: #fff;
    box-shadow: 0 4px 18px rgba(22,97,78,0.18);
  }
  .post-card.featured .post-thumb {
    border-color: rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.08);
  }
  .post-card.featured .post-date {
    color: rgba(255,255,255,0.85);
  }
  .post-card.featured .post-cat {
    background: rgba(255,255,255,0.18);
    color: #fff;
  }
  .post-card.featured .post-title {
    color: #fff;
  }
  .post-card.featured .post-excerpt {
    color: rgba(255,255,255,0.92);
  }
  .post-card.featured .post-link {
    color: var(--accent);
  }
  .recommend-badge {
    position: absolute;
    top: -10px;
    right: 20px;
    background: var(--accent);
    color: #fff;
    padding: 5px 14px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    box-shadow: 0 3px 10px rgba(212,160,77,0.35);
    z-index: 1;
  }
  .post-thumb {
    flex-shrink: 0;
    width: 100px;
    height: 100px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .post-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .post-body {
    flex: 1;
    min-width: 0;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
  }
  .post-date {
    font-family: "Space Grotesk", sans-serif;
    font-size: 13px;
    color: var(--text-light);
    letter-spacing: 0.05em;
  }
  .post-cat {
    display: inline-block;
    background: rgba(22,97,78,0.08);
    color: var(--sea);
    border-radius: 4px;
    padding: 3px 11px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .post-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.5;
    margin: 0 0 10px;
  }
  .post-excerpt {
    font-size: 14px;
    color: var(--text-light);
    line-height: 1.85;
    margin: 0 0 14px;
  }
  .post-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    color: var(--sea);
    font-family: "Space Grotesk", sans-serif;
  }

  .empty-state {
    text-align: center;
    padding: 60px 20px;
    color: var(--text-light);
  }

  /* AI事業の記事への誘導バナー */
  .featured-banner {
    display: block;
    max-width: 820px;
    margin: 0 auto 28px;
    text-decoration: none;
    color: inherit;
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
  }
  .featured-banner:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(5,32,24,0.12);
  }
  .featured-banner-inner {
    background: linear-gradient(135deg, var(--sea) 0%, #1a7a60 60%, var(--mint) 100%);
    padding: 40px 40px;
    position: relative;
  }
  .featured-banner-inner::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: radial-gradient(circle at 90% 20%, rgba(255,255,255,0.08) 0%, transparent 60%);
    pointer-events: none;
  }
  .featured-banner-text {
    position: relative;
    z-index: 1;
  }
  .featured-eyebrow {
    display: inline-block;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.2em;
    font-size: 11px;
    font-family: "Space Grotesk", sans-serif;
    margin-bottom: 14px;
    background: rgba(255,255,255,0.15);
    padding: 4px 12px;
    border-radius: 99px;
  }
  .featured-title {
    font-size: clamp(20px, 3vw, 26px);
    font-weight: 700;
    color: #fff;
    line-height: 1.5;
    margin: 0 0 12px;
  }
  .featured-desc {
    font-size: 14px;
    color: rgba(255,255,255,0.85);
    line-height: 1.85;
    margin: 0 0 18px;
    max-width: 560px;
  }
  .featured-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    font-family: "Space Grotesk", sans-serif;
    background: rgba(255,255,255,0.15);
    padding: 6px 16px;
    border-radius: 99px;
    transition: background 0.2s ease;
  }
  .featured-banner:hover .featured-link {
    background: rgba(255,255,255,0.25);
  }

  @media (max-width: 640px) {
    .hero { padding: 40px 16px 28px; }
    .post-card { padding: 20px; gap: 16px; }
    .post-thumb { width: 72px; height: 72px; border-radius: 10px; }
    .post-title { font-size: 17px; }
    .featured-banner-inner { padding: 28px 24px; }
    .featured-title { font-size: 19px; }
  }
</style>
