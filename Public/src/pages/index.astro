---
import fs from 'node:fs';
import Layout from '../layouts/Layout.astro';
import { characterImages } from '../data/characterImages';

// 生成イラストは順次追加中。存在するものだけ表示する（未生成でもレイアウトを壊さない）
const hasImage = (publicPath: string) =>
  fs.existsSync(new URL(`../../public${publicPath}`, import.meta.url));

const title = '株式会社コールテン｜人を大切にする経営を、理想で終わらせない。';
const description = '人を大切にしたい——そんな思いを持つ会社を、株式会社コールテンはAI活用サポート・コミュニケーション支援・採用サポートの3つで支えます。思いを毎日の仕組みに変える会社です。';
---

<Layout title={title} description={description} canonicalUrl="https://www.corduroy.co.jp/" ogUrl="https://www.corduroy.co.jp/">
  <script slot="head" is:inline>
    (() => {
      const key = 'corduroy-home-intro-v3';
      let completed = document.cookie
        .split('; ')
        .some((cookie) => cookie === `${key}=completed`);
      try {
        completed ||= localStorage.getItem(key) === 'completed';
      } catch {}
      if (!completed) {
        document.documentElement.dataset.homeIntro = 'show';
      }
    })();
  </script>

  <script slot="head" type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "株式会社コールテンは何をしている会社ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "「人を大切にする経営を、理想で終わらせない。」を掲げ、AI活用サポート・コミュニケーション支援・採用サポートの3つで、人を大切にしたい会社を支える福岡の会社です。AIで余白をつくり、対話で理解を育て、採用と定着まで一緒に整えます。"
          }
        },
        {
          "@type": "Question",
          "name": "どんな会社が対象ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "人を大切にしたいという思いを持つ中小企業・NPO・事業者が対象です。IT担当者がいない、パソコンが得意ではない現場への導入経験も豊富です。全国対応しています。"
          }
        },
        {
          "@type": "Question",
          "name": "何から相談すればいいですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "サービスを決めてから相談する必要はありません。まず「今、会社の中で何が起きているのか」を一緒に整理するところから始めます。トップページの相性チェックで、考え方が近いかを先に確かめることもできます。"
          }
        }
      ]
    }
  </script>

  <div
    id="homepage-intro"
    class="homepage-intro"
    role="dialog"
    aria-modal="true"
    aria-labelledby="intro-dialog-title"
    aria-describedby="intro-instructions"
    aria-hidden="true"
  >
    <h2 id="intro-dialog-title" class="intro-visually-hidden">株式会社コールテンの紹介</h2>
    <div class="intro-toolbar">
      <span class="intro-brand">CORDUROY / INTRODUCTION</span>
      <button class="intro-skip" type="button" data-intro-skip>スキップ</button>
    </div>

    <div class="intro-scenes">
      <section class="intro-scene is-active" data-intro-scene aria-hidden="false">
        <img class="intro-character intro-character-bow" src={characterImages.tiki.relaxed} alt="ティキちゃん" width="260" height="260" />
        <div class="intro-copy intro-copy-welcome">
          <p class="intro-main-copy">
            株式会社コールテンの<br />
            ホームページへ<br class="mobile-only" />来てくださって、<br />
            ありがとうございます。
          </p>
          <p class="intro-emphasis">本当にありがとうございます。</p>
        </div>
      </section>

      <section class="intro-scene" data-intro-scene aria-hidden="true">
        <div class="intro-copy">
          <img class="intro-book" src="https://res.cloudinary.com/dg3mdcuju/image/upload/f_webp,q_auto:good,w_360/v1764694229/%E3%81%8F%E3%81%BE%E3%81%AE%E3%82%B3%E3%83%BC%E3%83%AB%E3%83%86%E3%83%B3%E3%81%8F%E3%82%93_yze3al.jpg" alt="絵本『くまのコールテンくん』の表紙" width="180" height="252" loading="lazy" />
          <span class="intro-kicker">WHY "CORDUROY"?</span>
          <p class="intro-main-copy">
            社名は、絵本<br class="mobile-only" />『くまのコールテンくん』から。
          </p>
          <p class="intro-sub-copy">
            ボタンが欠けて売れ残ったぬいぐるみが、<br />
            そのままの姿で迎え入れられる物語です。
          </p>
        </div>
      </section>

      <section class="intro-scene" data-intro-scene aria-hidden="true">
        <div class="intro-copy">
          <span class="intro-kicker">A REAL DILEMMA</span>
          <p class="intro-main-copy">人を大切にしたい。</p>
          <p class="intro-sub-copy">
            でも、業績も上げなくてはいけない。<br />
            会社も成長させなくてはいけない。
          </p>
        </div>
      </section>

      <section class="intro-scene" data-intro-scene aria-hidden="true">
        <div class="intro-copy">
          <span class="intro-kicker">THE SPACE BETWEEN</span>
          <p class="intro-main-copy">
            その間で生まれる<br />
            すれ違いがある。
          </p>
          <p class="intro-sub-copy">誰かが悪いから、とは限りません。</p>
        </div>
      </section>

      <section class="intro-scene intro-scene-final" data-intro-scene aria-hidden="true">
        <img class="intro-character intro-character-listening" src={characterImages.teto.listening} alt="耳を澄ます盤上テトくん" width="260" height="260" />
        <div class="intro-copy">
          <span class="intro-kicker">OUR DECISION</span>
          <p class="intro-main-copy">
            仕方のないことに、<br />
            しない。
          </p>
          <p class="intro-sub-copy">その思いを、会社の仕組みにする。</p>
          <p class="intro-peek">コールテンは、こんな会社です。</p>
          <a class="intro-story-link" href="/story/">はじまりの話をゆっくり読む <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </div>

    <div class="intro-controls">
      <p id="intro-instructions" class="intro-instructions">スクロール、スワイプ、矢印キーでも進めます</p>
      <div class="intro-progress" role="group" aria-label="イントロの進行状況">
        <button class="intro-dot is-active" type="button" data-intro-go="0" aria-label="1ページ目へ" aria-current="step"></button>
        <button class="intro-dot" type="button" data-intro-go="1" aria-label="2ページ目へ"></button>
        <button class="intro-dot" type="button" data-intro-go="2" aria-label="3ページ目へ"></button>
        <button class="intro-dot" type="button" data-intro-go="3" aria-label="4ページ目へ"></button>
        <button class="intro-dot" type="button" data-intro-go="4" aria-label="5ページ目へ"></button>
      </div>
      <button class="intro-next" type="button" data-intro-next>
        <span data-intro-next-label>つづく</span>
        <span aria-hidden="true">↓</span>
      </button>
      <span class="intro-status" aria-live="polite" data-intro-status>1 / 5</span>
    </div>
  </div>

  <main id="main-content" class="home-main" tabindex="-1">
    <!-- S01 ファーストビュー -->
    <section class="home-hero" aria-labelledby="hero-title">
      <div class="hero-weave" aria-hidden="true"></div>
      <button class="hero-intro-replay" type="button" data-home-intro-replay aria-label="はじめての方向けのイントロを再生する"><span aria-hidden="true">▶</span> はじめての方へ</button>
      <div class="home-shell hero-content">
        <div class="hero-meta">
          <p class="eyebrow">株式会社コールテン</p>
        </div>
        <h1 id="hero-title">
          人<span class="k">を</span>大切<span class="k">にする</span><br class="mobile-only" />経営<span class="k">を、</span><br />
          <span class="accent-line">理想<span class="k">で</span>終<span class="k">わらせない。</span></span>
        </h1>
        <p class="hero-lead">
          人を大切にしたい思いを、新しいやり方で形に。<br />
          AI、コーチング、海外との関わり——<br class="desktop-only" />
          コールテンは広い視点で、あなたの会社の隣に立ちます。
        </p>
        <div class="hero-actions">
          <a class="home-button home-button-primary" href="#services">コールテンの支援を見る <span aria-hidden="true">↓</span></a>
          <a class="home-button home-button-text" href="/story/">はじまりの話を読む <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <!-- S02 経営者の悩み -->
    <section id="worries" class="r-worry" aria-labelledby="worry-sr-title">
      <div class="home-shell">
        <h2 id="worry-sr-title" class="r-visually-hidden">人を大切にしたいのに、できない悩み</h2>


                  <ul class="r-worry-list fade-up">
            <li>社員を大事にしたい。でも、目の前の数字に追われている</li>
            <li>「AIで楽になる」と聞くけれど、うちの現場で使える気がしない</li>
            <li>よかれと思った声かけが、若手を追い詰めていたと後から知った</li>
            <li>会議で発言するのは、いつも同じ顔ぶれ</li>
            <li>求人への応募が、年々減っている</li>
            <li>外国人材も考えたいが、何から始めればいいか分からない</li>
          </ul>


        <p class="r-changes-close fade-up"><span class="k">その</span>悩<span class="k">みを、</span>コールテン<span class="k">が</span>隣<span class="k">でサポートします。</span></p>
      </div>
    </section>

    <!-- S04 3つの支援（変化タグ吸収・AI=土台の大カード＋下段2カラム） -->
    <section id="services" class="r-biz" aria-labelledby="biz-title">
      <div class="home-shell">
        <div class="r-heading fade-up">
          <h2 id="biz-title">3<span class="k">つの</span>支援<span class="k">。</span></h2>
        </div>
        <div class="r-biz-layout">

          <article id="business-ai" class="r-biz-card r-biz-main fade-up">
            <span class="r-ribbon" aria-hidden="true">オススメ</span>
            {hasImage("/images/top/support-ai.png") && <img class="r-biz-img" src="/images/top/support-ai.png" alt="" width="1536" height="1024" loading="lazy" />}
            <div class="r-biz-meta"><span class="r-biz-no">01</span><p>AI活用サポート</p></div>
            <p class="r-bg-tag">背景: AIが進む</p>
            <h3>AI<span class="k">で、</span>人<span class="k">と</span>向<span class="k">き</span>合<span class="k">う</span>時間<span class="k">を</span>取<span class="k">り</span>戻<span class="k">す。</span></h3>
            <p class="r-biz-lead">「難しいAI」ではなく、現場の人が使える「やさしいAI活用」。任せられる仕事はAIに任せて、人と向き合う時間を取り戻します。</p>
            <p class="r-biz-lead">実際の仕事の整理から、現場に合わせた使い方の設計、研修・仕組み化まで一緒に。パソコンが苦手な現場への導入経験も豊富です。</p>
            <details class="r-acc">
              <summary>詳細</summary>
              <div class="r-acc-body">
                <div class="r-baf">
                  <div class="r-baf-col is-before">
                    <h3>Before</h3>
                    <ul>
                      <li>事務作業に時間がかかる</li>
                      <li>AIが難しそう</li>
                      <li>詳しい人しか使えない</li>
                      <li>導入しても定着しない</li>
                    </ul>
                  </div>
                  <div class="r-baf-arrow" aria-hidden="true"></div>
                  <div class="r-baf-col is-mid">
                    <h3>コールテンの支援</h3>
                    <ul>
                      <li>実際の仕事を一緒に整理</li>
                      <li>AIが使える場所を探す</li>
                      <li>現場に合わせて使い方を設計</li>
                      <li>必要に応じて研修・仕組み化</li>
                    </ul>
                  </div>
                  <div class="r-baf-arrow" aria-hidden="true"></div>
                  <div class="r-baf-col is-after">
                    <h3>After</h3>
                    <ul>
                      <li>単純作業が軽くなる</li>
                      <li>AIを現場で使える</li>
                      <li>人と話す時間が増える</li>
                      <li>本来の仕事に集中できる</li>
                    </ul>
                  </div>
                </div>
                <div class="r-time">
                  <div class="r-time-col is-cut">
                    <h3>AI<span class="k">で</span>減<span class="k">らしたい</span>時間</h3>
                    <ul>
                      <li>書き直し</li>
                      <li>情報探し</li>
                      <li>転記・単純作業</li>
                      <li>同じ説明の繰り返し</li>
                    </ul>
                  </div>
                  <div class="r-time-mid" aria-hidden="true"><span>→</span></div>
                  <div class="r-time-col is-grow">
                    <h3>AI<span class="k">で</span>増<span class="k">やしたい</span>時間</h3>
                    <ul>
                      <li>対話・顧客対応</li>
                      <li>企画</li>
                      <li>振り返り</li>
                      <li>人にしかできない仕事</li>
                    </ul>
                  </div>
                </div>
                <div class="r-strength">
                  <p>コールテンは、福祉事業者・非営利団体・IT担当者のいない組織など、<strong>IT導入が進んでいない現場との仕事を多く経験してきました</strong>。最新ツールの紹介よりも、「この人たちが実際に使えるところまで一緒に考える」こと。パソコンが得意ではない人がいる会社でも、やさしく、分かりやすく進めます。</p>
                </div>
              </div>
            </details>
            <a class="r-biz-link" href="/ai/">AI事業のページを見る <span aria-hidden="true">→</span></a>
          </article>

          <div class="r-biz-sub">
          <article id="business-coaching" class="r-biz-card fade-up">
            {hasImage("/images/top/support-comm.png") && <img class="r-biz-img" src="/images/top/support-comm.png" alt="" width="1536" height="1024" loading="lazy" />}
            <div class="r-biz-meta"><span class="r-biz-no">02</span>
              <p>コミュニケーション支援</p>
              </div>
            <p class="r-bg-tag">背景: 人が多様になる</p>
            <h3>違<span class="k">いを、</span>対立<span class="k">で</span>終<span class="k">わらせない。</span></h3>
            <p class="r-biz-lead">相手を変えるための研修ではありません。AI時代だからこそ価値が上がる「聞く・理解する・一緒に考える」を、チームの力にします。</p>
            <p class="r-biz-lead">コーチングをベースに、経営陣と現場の橋渡しや、上司と部下の関係づくりを支えます。いまはテスト提供中。一緒に形をつくる会社を歓迎します。</p>
            <details class="r-acc">
              <summary>詳細</summary>
              <div class="r-acc-body">
                <div class="r-chains is-light">
                  <div class="r-chain is-bad">
                    <h3>すれ違<span class="k">いの</span>構造</h3>
                    <ol>
                      <li>世代・価値観・立場・経験の違い</li>
                      <li>伝わらない</li>
                      <li>決めつける</li>
                      <li>話さなくなる</li>
                      <li>関係が悪くなる</li>
                    </ol>
                  </div>
                  <div class="r-chain is-good">
                    <h3>理解<span class="k">し</span>合<span class="k">える</span>流<span class="k">れ</span></h3>
                    <ol>
                      <li>聞く</li>
                      <li>背景を知る</li>
                      <li>伝え方を変える</li>
                      <li>お互いを理解する</li>
                      <li>一緒に仕事ができる</li>
                    </ol>
                  </div>
                </div>
                <div class="r-acc-note">
                  <p>AIができる仕事が増えるほど、<strong>聞く・理解する・意味を考える・一緒に答えを探す</strong>——人間だからこそできることの価値が上がります。話し方の研修ではなく、働く意味・関係性・理解・対話まで含めた支援です。</p>
                  <p>代表自身も、人とのコミュニケーションに悩んだ経験からコーチングを学び、プロのコーチとして人の話を聞く仕事をしてきました。そこで学んだのは「正しいことを伝えるだけでは、人は必ずしも前に進まない」ということ。相手を知り、自分を知り、違いを理解する——その経験を組織支援に活かしています。</p>
                </div>
              </div>
            </details>
          </article>

          <article id="business-hiring" class="r-biz-card is-preparing fade-up">
            <span id="business-foreign" class="r-anchor-alias" aria-hidden="true"></span>
            {hasImage("/images/top/support-hiring.png") && <img class="r-biz-img" src="/images/top/support-hiring.png" alt="" width="1536" height="1024" loading="lazy" />}
            <div class="r-biz-meta"><span class="r-biz-no">03</span><p>採用サポート</p><em class="r-prep-tag">準備中（登録支援機関 申請準備中）</em></div>
            <p class="r-bg-tag">背景: 働き手が減る</p>
            <h3>採用<span class="k">は、</span>会社<span class="k">の</span>魅力<span class="k">を</span>伝<span class="k">える</span>仕事<span class="k">。</span></h3>
            <p class="r-biz-lead">採用はマーケティングです。求人の打ち出し方から、外国人材の採用・定着まで、「選ばれて、長く続く採用」を一緒につくります。</p>
            <p class="r-biz-lead">会社の魅力の言語化、採用広報の見直し、入社後の定着設計まで。いまは事業開始に向けて準備を進めています。</p>
            <details class="r-acc">
              <summary>詳細</summary>
              <div class="r-acc-body">
                <div class="r-acc-note">
                  <p>「求人を出しても来ない」の多くは、条件ではなく<strong>伝わり方</strong>の問題です。どんな会社で、誰と、どんなふうに働けるのか——会社の中にある魅力を言葉にして、届く形で打ち出すところから一緒に整えます。</p>
                  <p>そして少子高齢化が進む日本では、海外から来る人と働くことも、長い目で見た採用の選択肢になります。「人手不足だから」で終わらせず、お互いが安心できる関係づくりまで支援します。</p>
                </div>
                <div class="r-steps">
                  <div class="r-step">
                    <span class="r-step-no">STEP 1</span>
                    <h3>採用前</h3>
                    <ul>
                      <li>受け入れ準備</li>
                      <li>制度理解</li>
                      <li>ミスマッチを減らす</li>
                    </ul>
                  </div>
                  <div class="r-step-arrow" aria-hidden="true"></div>
                  <div class="r-step">
                    <span class="r-step-no">STEP 2</span>
                    <h3>入社時</h3>
                    <ul>
                      <li>仕事と生活の不安に寄り添う</li>
                      <li>言葉の違い</li>
                      <li>文化の違い</li>
                    </ul>
                  </div>
                  <div class="r-step-arrow" aria-hidden="true"></div>
                  <div class="r-step">
                    <span class="r-step-no">STEP 3</span>
                    <h3>定着</h3>
                    <ul>
                      <li>困ったときに相談できる</li>
                      <li>会社側も相談できる</li>
                      <li>安心して長く働ける</li>
                    </ul>
                  </div>
                </div>
                <div class="r-bridge">
                  <div class="r-bridge-node">会社</div>
                  <div class="r-bridge-mid"><span aria-hidden="true">⇄</span><em>コールテン</em><span aria-hidden="true">⇄</span></div>
                  <div class="r-bridge-node">外国人材</div>
                </div>
                <div class="r-acc-note">
                  <p>どちらか一方の代理ではなく、<strong>企業と働く人の間に立ち、よい関係をつくる</strong>役割です。代表自身も海外留学や海外で働いた経験があり、知らない土地で現地の人に助けてもらいました。日本に来る人にも「日本に来てよかった」と思ってほしい——その思いも、この支援に重なっています。</p>
                </div>
              </div>
            </details>
          </article>
          </div>
        </div>
      </div>
    </section>

    <!-- S08 おすすめの利用順（3ステップ） -->
    <section id="loop" class="r-loop" aria-labelledby="loop-title">
      <div class="home-shell">
        <div class="r-heading fade-up">
          <h2 id="loop-title">利用<span class="k">イメージ。</span></h2>
        </div>
        <div class="r-order fade-up" role="img" aria-label="AI活用サポートで余白をつくり、コミュニケーション支援で定着の土台を整え、採用サポートでいい循環へ、の3ステップ図">
          <div class="r-order-step">
            <span class="r-order-no">STEP 1</span>
            <h3>AI活用サポート</h3>
            <p class="r-order-effect">業務<span class="k">の</span>負担<span class="k">を</span>減<span class="k">らして、</span><br /><strong>余白<span class="k">をつくる</span></strong></p>
            <p class="r-order-why">いちばん効率が上がりやすいので、まずここから。</p>
          </div>
