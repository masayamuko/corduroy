<script>
  const STORAGE_KEY = 'corduroy-home-intro-v3';

  function setupHomepageIntro() {
    const intro = document.getElementById('homepage-intro');
    if (!intro) return;

    const scenes = Array.from(intro.querySelectorAll<HTMLElement>('[data-intro-scene]'));
    const dots = Array.from(intro.querySelectorAll<HTMLButtonElement>('[data-intro-go]'));
    const nextButton = intro.querySelector<HTMLButtonElement>('[data-intro-next]');
    const nextLabel = intro.querySelector<HTMLElement>('[data-intro-next-label]');
    const skipButton = intro.querySelector<HTMLButtonElement>('[data-intro-skip]');
    const status = intro.querySelector<HTMLElement>('[data-intro-status]');
    const main = document.getElementById('main-content');
    let currentStep = 0;
    let lastAdvanceAt = 0;
    let touchStartY = 0;
    let lockedScrollY = 0;
    let returnFocus: HTMLElement | null = null;
    let inertSiblings: Array<{ element: HTMLElement; wasInert: boolean }> = [];

    const saveCompletion = () => {
      try {
        localStorage.setItem(STORAGE_KEY, 'completed');
      } catch {}
      try {
        document.cookie = `${STORAGE_KEY}=completed; Max-Age=31536000; Path=/; SameSite=Lax`;
      } catch {}
    };

    const setBackgroundInert = (inert: boolean) => {
      if (inert) {
        inertSiblings = Array.from(document.body.children)
          .filter((element): element is HTMLElement => element instanceof HTMLElement && element !== intro)
          .map((element) => ({ element, wasInert: element.inert }));
        inertSiblings.forEach(({ element }) => { element.inert = true; });
        return;
      }
      inertSiblings.forEach(({ element, wasInert }) => { element.inert = wasInert; });
      inertSiblings = [];
    };

    const renderStep = (step: number) => {
      currentStep = Math.max(0, Math.min(step, scenes.length - 1));
      scenes.forEach((scene, index) => {
        const active = index === currentStep;
        scene.classList.toggle('is-active', active);
        scene.setAttribute('aria-hidden', String(!active));
        scene.toggleAttribute('inert', !active);
      });
      dots.forEach((dot, index) => {
        const active = index === currentStep;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'step');
        else dot.removeAttribute('aria-current');
      });
      if (nextLabel) nextLabel.textContent = currentStep === scenes.length - 1 ? '始めましょう' : 'つづく';
      if (status) status.textContent = `${currentStep + 1} / ${scenes.length}`;
    };

    const closeIntro = (remember = true) => {
      if (remember) saveCompletion();
      intro.classList.remove('is-open');
      intro.setAttribute('aria-hidden', 'true');
      document.documentElement.dataset.homeIntro = 'hidden';
      document.body.classList.remove('home-intro-open');
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      setBackgroundInert(false);
      window.scrollTo(0, lockedScrollY);
      window.removeEventListener('wheel', onWheel);
      window.removeEventListener('keydown', onKeydown);
      intro.removeEventListener('touchstart', onTouchStart);
      intro.removeEventListener('touchend', onTouchEnd);
      if (returnFocus) returnFocus.focus({ preventScroll: true });
      else main?.focus({ preventScroll: true });
    };

    const nextStep = () => {
      if (currentStep >= scenes.length - 1) {
        closeIntro(true);
        return;
      }
      renderStep(currentStep + 1);
    };

    const previousStep = () => renderStep(currentStep - 1);

    function onWheel(event: WheelEvent) {
      event.preventDefault();
      const now = Date.now();
      if (now - lastAdvanceAt < 650 || Math.abs(event.deltaY) < 18) return;
      lastAdvanceAt = now;
      if (event.deltaY > 0) nextStep();
      else previousStep();
    }

    function onKeydown(event: KeyboardEvent) {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeIntro(true);
        return;
      }
      if (event.key === 'Tab') {
        if (!intro) return;
        const focusable = Array.from(intro.querySelectorAll<HTMLElement>('button:not([disabled]), a[href]'))
          .filter((element) => element.offsetParent !== null);
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!intro.contains(document.activeElement)) {
          event.preventDefault();
          first.focus();
        } else if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
        return;
      }
      const target = event.target instanceof HTMLElement ? event.target : null;
      const usesNativeActivation = Boolean(target?.closest('button, a[href], input, select, textarea, [role="button"]'));
      if (['ArrowDown', 'PageDown'].includes(event.key) || (!usesNativeActivation && [' ', 'Enter'].includes(event.key))) {
        event.preventDefault();
        nextStep();
      }
      if (['ArrowUp', 'PageUp'].includes(event.key)) {
        event.preventDefault();
        previousStep();
      }
    }

    function onTouchStart(event: TouchEvent) {
      touchStartY = event.changedTouches[0]?.clientY ?? 0;
    }

    function onTouchEnd(event: TouchEvent) {
      const touchEndY = event.changedTouches[0]?.clientY ?? touchStartY;
      const distance = touchStartY - touchEndY;
      if (Math.abs(distance) < 44) return;
      if (distance > 0) nextStep();
      else previousStep();
    }

    const openIntro = (trigger?: HTMLElement | null) => {
      returnFocus = trigger ?? null;
      renderStep(0);
      intro.classList.add('is-open');
      intro.setAttribute('aria-hidden', 'false');
      document.documentElement.dataset.homeIntro = 'show';
      document.body.classList.add('home-intro-open');
      lockedScrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${lockedScrollY}px`;
      document.body.style.width = '100%';
      setBackgroundInert(true);
      window.addEventListener('wheel', onWheel, { passive: false });
      window.addEventListener('keydown', onKeydown);
      intro.addEventListener('touchstart', onTouchStart, { passive: true });
      intro.addEventListener('touchend', onTouchEnd, { passive: true });
      window.requestAnimationFrame(() => nextButton?.focus({ preventScroll: true }));
    };

    nextButton?.addEventListener('click', nextStep);
    skipButton?.addEventListener('click', () => closeIntro(true));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => renderStep(Number(dot.dataset.introGo ?? 0)));
    });

    document.querySelectorAll<HTMLElement>('[data-home-intro-replay]').forEach((button) => {
      button.addEventListener('click', () => openIntro(button));
    });

    if (document.documentElement.dataset.homeIntro === 'show') openIntro();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHomepageIntro, { once: true });
  } else {
    setupHomepageIntro();
  }
</script>

<script>
  // ===== 相性チェック（スライダー7段階・中央スタート） =====
  (() => {
    const root = document.getElementById('fitcheck');
    if (!root) return;
    const QS: [string, string][] = [
      ['人を大切にする', '利益・成長スピードを最優先'],
      ['じっくり関係を育てたい', 'すぐに成果を出したい'],
      ['現場の声から変えたい', 'トップの決断で速く変えたい'],
      ['AIで対話の時間を増やしたい', 'AIで人件費を減らしたい'],
      ['社会への意味も大切にする', 'まず自社の数字を伸ばしたい'],
    ];
    const CP = [1, 1, 2, 1, 2]; // コールテンの位置（0-6の7段階）
    const CENTER = 3;
    const vals = Array(QS.length).fill(CENTER);
    const answered = Array(QS.length).fill(false);
    const qsWrap = root.querySelector<HTMLElement>('.fitcheck-qs');
    const result = root.querySelector<HTMLElement>('.fitcheck-result');
    if (!qsWrap || !result) return;

    const progress = document.createElement('p');
    progress.className = 'fitcheck-progress';
    progress.textContent = '回答 0 / 5';
    qsWrap.before(progress);

    QS.forEach((q, i) => {
      const box = document.createElement('div');
      box.className = 'fitcheck-q';
      box.innerHTML =
        `<span class="fitcheck-done-badge">✓ 回答済み</span>` +
        `<div class="fitcheck-lab"><span>← ${q[0]}</span><span>${q[1]} →</span></div>` +
        `<div class="fitcheck-slider"><div class="fitcheck-ticks"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>` +
        `<input type="range" min="0" max="6" step="1" value="${CENTER}" aria-label="${q[0]}か、${q[1]}か（7段階・中央はどちらとも）"></div>`;
      const input = box.querySelector<HTMLInputElement>('input')!;
      const mark = () => {
        vals[i] = Number(input.value);
        if (!answered[i]) {
          answered[i] = true;
          box.classList.add('done');
        }
        update();
      };
      input.addEventListener('input', mark);
      input.addEventListener('pointerup', mark); // 触れただけ（中央のまま）でも回答扱い
      input.addEventListener('keyup', mark);
      qsWrap.appendChild(box);
    });

    function update() {
      const n = answered.filter(Boolean).length;
      progress.textContent = `回答 ${n} / ${QS.length}`;
      if (n < QS.length || !result) return;
      const diff = vals.reduce((s, v, i) => s + Math.abs(v - CP[i]), 0);
      let verdict = '';
      let msg = '';
      let cta = '';
      if (diff <= 6) {
        verdict = '相性、良さそうです。';
        msg = '優先順位の置き方が、私たちとよく似ています。きっとお力になれると思います。';
        cta = '問い合わせてみる';
      } else if (diff <= 13) {
        verdict = '重なるところが、ありそうです。';
        msg = '重なる部分と、違う部分がありそうです。重なるところからなら、一緒に進められるかもしれません。';
        cta = 'まず小さく相談してみる';
      } else {
        verdict = '正直にお伝えすると——';
        msg = '考え方に、少し違うところがありそうです。「速さと数字」に強い軸をお持ちなら、効率化に特化したAI導入会社の方がきっとお力になれます。それも正しい選択だと、私たちは思います。';
        cta = '';
      }
      let bars = '';
      QS.forEach((q, i) => {
        bars += `<p class="fitcheck-legend">${q[0]} ⇔ ${q[1]}</p><div class="fitcheck-scale"><i class="dc" style="left:${(CP[i] / 6) * 88 + 6}%"></i><i class="du" style="left:${(vals[i] / 6) * 88 + 6}%"></i></div>`;
      });
      result.classList.add('on');
      const ctaHtml = cta ? `<a class="fitcheck-cta" href="/contact/" data-ga-event="cta_click" data-ga-label="fitcheck_contact">${cta} <span aria-hidden="true">→</span></a>` : '';
      result.innerHTML = `<div class="fitcheck-card"><p class="fitcheck-verdict">${verdict}</p><p class="fitcheck-legend">● 緑=コールテン / ● 橙=あなた。点数ではなく「近さ」を見ています。</p>${bars}<p class="fitcheck-msg">${msg}</p>${ctaHtml}</div>`;
      result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  })();
</script>

